---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { additionalProjects, featuredProjects } from "../data/projects";
---

<BaseLayout>
  <Header />
  <main id="main" class="home-main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-availability"><span aria-hidden="true"></span>New York · Graduating December 2026</p>
        <h1 id="hero-title" class="hero-statement">
          I build AI products for <em>complex operational work.</em>
        </h1>
        <p class="hero-summary">
          An applied AI and data engineer working across multimodal review, agent workflows and data-intensive decisions—without hiding the evidence or the human judgment.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          <a class="text-action" href="mailto:huang0818hqj@outlook.com">huang0818hqj@outlook.com</a>
        </div>
      </div>

      <div class="hero-credentials" aria-label="Professional overview">
        <p class="credentials-label">At a glance</p>
        <dl>
          <div>
            <dt>Current</dt>
            <dd><strong>AI &amp; Data Engineer Intern</strong><span>Deutsche Windtechnik · 2026—Now</span></dd>
          </div>
          <div>
            <dt>Previous</dt>
            <dd><strong>Data Analyst</strong><span>Temu · 2024—2025</span></dd>
          </div>
          <div>
            <dt>Education</dt>
            <dd><strong>MS Applied Analytics</strong><span>Columbia University · GPA 4.0</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <div class="section-intro">
        <p class="section-index">01 / Selected work</p>
        <div>
          <h2 id="work-title">Products built to survive the real workflow.</h2>
          <p>Three end-to-end systems showing how I frame risk, design the human boundary and turn emerging AI capabilities into accountable products.</p>
        </div>
      </div>

      <div class="featured-work">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="more-work" aria-labelledby="more-work-title">
        <div class="more-work-heading">
          <p class="section-index">In the lab</p>
          <h3 id="more-work-title">Smaller systems, shipped with intent.</h3>
        </div>
        <div class="more-work-list">
          {additionalProjects.map((project) => <ProjectCard project={project} compact />)}
        </div>
      </div>
    </section>

    <section class="experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-intro">
        <p class="section-index">02 / Experience</p>
        <div>
          <h2 id="experience-title">Building inside real constraints.</h2>
          <p>Experience spanning enterprise AI delivery, product analytics and evidence-based decision support.</p>
        </div>
      </div>

      <div class="experience-list">
        <article class="experience-row">
          <div class="experience-period">2026—Now</div>
          <div class="experience-role"><h3>AI &amp; Data Engineer Intern</h3><p>Deutsche Windtechnik · Houston / Global</p></div>
          <p class="experience-description">Evaluate and build AI-assisted workflows for enterprise operations, translating ambiguous stakeholder requests into bounded products with explicit privacy, validation and review controls.</p>
        </article>
        <article class="experience-row">
          <div class="experience-period">2024—25</div>
          <div class="experience-role"><h3>Data Analyst</h3><p>Temu · Shenzhen</p></div>
          <p class="experience-description">Analyzed acquisition, activation, retention and monetization across more than 20 markets; automated recurring reporting and translated funnel behavior into growth decisions.</p>
        </article>
        <article class="experience-row">
          <div class="experience-period">2023</div>
          <div class="experience-role"><h3>Research &amp; Finance Internships</h3><p>Securities research and corporate finance</p></div>
          <p class="experience-description">Worked across equity research, macroeconomic analysis and financial reporting, building an early foundation in rigorous analysis and executive communication.</p>
        </article>
      </div>

      <aside class="work-boundary" aria-label="Confidential work boundary">
        <span class="boundary-mark" aria-hidden="true">⌁</span>
        <div>
          <p class="section-index">A note on professional work</p>
          <h3>Confidentiality is part of the design constraint.</h3>
        </div>
        <p>Protected data, internal interfaces and operating details are intentionally omitted. I show the problem class, my responsibility, system boundaries and decisions at a level appropriate for public review.</p>
      </aside>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="section-intro">
        <p class="section-index">03 / About</p>
        <div>
          <h2 id="about-title">Technical depth, product judgment.</h2>
          <p>I am most useful where the problem is consequential, the requirements are still moving and a credible solution needs both engineering and judgment.</p>
        </div>
      </div>

      <div class="about-grid">
        <figure class="about-portrait">
          <img src="/images/kimberly-portrait.jpg" alt="Kimberly Huang" width="1800" height="2400" loading="lazy" />
          <figcaption>Kimberly (Qijing) Huang · New York</figcaption>
        </figure>
        <div class="about-copy">
          <p class="about-lede">My work sits between applied AI, data engineering and product design. I care about where a system should stop—not only what it can automate.</p>
          <p>That means designing explicit review boundaries, separating model output from observable evidence and building interfaces that make uncertainty legible.</p>
          <div class="education-stack">
            <article><span>2025—26</span><div><h3>Columbia University</h3><p>MS Applied Analytics · GPA 4.0 · Expected Dec 2026</p></div></article>
            <article><span>Undergraduate</span><div><h3>University of Dundee</h3><p>BSc Applied Finance · Top 1% · ACCA certified</p></div></article>
          </div>
        </div>
      </div>

      <div class="capability-grid" aria-label="Core capabilities">
        <article><span>01</span><h3>Applied AI systems</h3><p>Multimodal extraction, agent orchestration, evaluation, retrieval, guardrails and human review.</p></article>
        <article><span>02</span><h3>Product engineering</h3><p>Python, TypeScript, SQL, Next.js, FastAPI, APIs, GitHub Actions and Vercel.</p></article>
        <article><span>03</span><h3>Data &amp; decisions</h3><p>Analytics engineering, experimentation, funnel analysis, financial analysis and executive communication.</p></article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
