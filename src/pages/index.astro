---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import Footer from "../components/Footer.astro";
import { additionalProjects, featuredProjects } from "../data/projects";
import { site } from "../data/site";

// The hero slot goes to the build with external recognition, not simply the first one.
const featuredBuild =
  featuredProjects.find((project) => project.award) ?? featuredProjects[0];
---

<BaseLayout>
  <Header />
  <main id="main" class="home-main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="hero-identity">
            <picture>
              <source srcset="/images/kimberly-avatar-256.webp" type="image/webp" />
              <img
                class="hero-avatar"
                src="/images/kimberly-avatar-256.jpg"
                alt="Kimberly Huang"
                width="256"
                height="256"
                fetchpriority="high"
              />
            </picture>
            <div class="hero-identity-copy">
              <p class="hero-name">Kimberly (Qijing) Huang</p>
              <p class="hero-role">Applied AI &amp; Data Engineer · New York</p>
              <p class="eyebrow"><span aria-hidden="true"></span>Graduating December 2026 · open to full-time roles in 2027</p>
            </div>
          </div>
          <h1 id="hero-title">Applied AI,<br /><em>engineered for real work.</em></h1>
          <p class="hero-summary">
            I build human-in-the-loop products that turn messy inputs into inspectable decisions—combining multimodal AI, deterministic validation and production-minded interfaces.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">View selected work <span aria-hidden="true">↓</span></a>
            <a class="button button-secondary" href={`mailto:${site.email}`}>Start a conversation <span aria-hidden="true">↗</span></a>
            <a class="button-quiet" href={site.resume}>Résumé (PDF) <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">Python · TypeScript · SQL · LLM APIs · Next.js · PostgreSQL &middot; MS Applied Analytics at Columbia University</p>
        </div>

        <aside class="hero-feature" aria-label="Featured project">
          <div class="hero-feature-topline">
            <span>Most recognised build</span>
            <span>{featuredBuild.award ?? featuredBuild.status}</span>
          </div>
          <a href={`/work/${featuredBuild.slug}`} class="hero-feature-visual" aria-label={`Explore ${featuredBuild.title}`}>
            <ProjectPreview kind={featuredBuild.preview} />
          </a>
          <div class="hero-feature-copy">
            <div>
              <p>{featuredBuild.eyebrow}</p>
              <h2>{featuredBuild.title}</h2>
            </div>
            <a href={`/work/${featuredBuild.slug}`}>Case study <span aria-hidden="true">→</span></a>
          </div>
        </aside>
      </div>

      <dl class="hero-proof" aria-label="Professional overview">
        <div>
          <dt>Now</dt>
          <dd><strong>AI &amp; Data Engineer Intern</strong><span>Deutsche Windtechnik</span></dd>
        </div>
        <div>
          <dt>Before</dt>
          <dd><strong>Product analytics across 20+ markets</strong><span>Temu</span></dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd><strong>MS Applied Analytics · GPA 4.0</strong><span>Columbia University</span></dd>
        </div>
      </dl>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="section-label">01 / Selected work</p>
        <div>
          <h2 id="work-title">Built, tested and documented.</h2>
          <p>Three systems showing the product decisions, technical boundaries and evidence behind the interface—not just the finished screen.</p>
        </div>
      </div>

      <div class="featured-work">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="more-work" aria-labelledby="more-work-title">
        <div class="more-work-heading">
          <p class="section-label">Additional builds</p>
          <h3 id="more-work-title">Smaller systems,<br />clear intent.</h3>
        </div>
        <div class="more-work-list">
          {additionalProjects.map((project) => <ProjectCard project={project} compact />)}
        </div>
      </div>
    </section>

    <section class="experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="section-label">02 / Experience</p>
        <div>
          <h2 id="experience-title">Engineering judgment under real constraints.</h2>
          <p>Work spanning enterprise AI delivery, product analytics and evidence-based decisions.</p>
        </div>
      </div>

      <div class="experience-list">
        <article class="experience-row">
          <p class="experience-period">2026—Now</p>
          <div class="experience-role">
            <h3>AI &amp; Data Engineer Intern</h3>
            <p>Deutsche Windtechnik · Houston / Global</p>
          </div>
          <p class="experience-description">Evaluate and build AI-assisted workflows for enterprise operations, translating ambiguous stakeholder needs into bounded products with explicit privacy, validation and human-review controls.</p>
          <ul aria-label="Focus areas"><li>Applied AI</li><li>Workflow design</li><li>Enterprise delivery</li></ul>
        </article>
        <article class="experience-row">
          <p class="experience-period">2024—25</p>
          <div class="experience-role">
            <h3>Data Analyst</h3>
            <p>Temu · Shenzhen</p>
          </div>
          <p class="experience-description">Analyzed acquisition, activation, retention and monetization across more than 20 markets; automated recurring reporting and translated funnel behavior into growth decisions.</p>
          <ul aria-label="Focus areas"><li>20+ markets</li><li>Funnel analytics</li><li>Automation</li></ul>
        </article>
        <article class="experience-row experience-row-secondary">
          <p class="experience-period">2023</p>
          <div class="experience-role">
            <h3>Research &amp; Finance Internships</h3>
            <p>Securities research and corporate finance</p>
          </div>
          <p class="experience-description">Built an early foundation in rigorous analysis, financial reporting and executive communication.</p>
          <ul aria-label="Focus areas"><li>Research</li><li>Financial analysis</li></ul>
        </article>
      </div>

      <aside class="work-boundary" aria-label="Confidential work boundary">
        <span class="boundary-mark" aria-hidden="true">NDA</span>
        <div>
          <p class="section-label">Professional work</p>
          <h3>Confidentiality is an engineering constraint.</h3>
        </div>
        <p>Protected data and internal interfaces are intentionally omitted. Public case studies show the problem class, my responsibility, system boundaries and decisions at a level appropriate for review.</p>
      </aside>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="section-label">03 / About</p>
        <div>
          <h2 id="about-title">Technical depth,<br />product judgment.</h2>
          <p>I am most useful where the requirements are moving and a credible product needs both engineering discipline and a clear human boundary.</p>
        </div>
      </div>

      <div class="about-grid">
        <div class="about-copy">
          <p class="about-lede">The hard part is the boundary: what the model may decide, what code must decide, and what a person has to sign.</p>
          <p>So I separate probabilistic perception from deterministic checks, keep the evidence behind a recommendation visible, and design the point where automation stops before it costs someone money or trust.</p>
        </div>

        <div class="education-stack" aria-label="Education">
          <article><span>2025—26</span><div><h3>Columbia University</h3><p>MS Applied Analytics · GPA 4.0 · Expected December 2026</p></div></article>
          <article><span>Undergraduate</span><div><h3>University of Dundee</h3><p>BSc Applied Finance · Top 1% · ACCA certified</p></div></article>
        </div>
      </div>

      <div class="capability-grid" aria-label="Core capabilities">
        <article><span>01</span><h3>Applied AI systems</h3><p>Multimodal extraction, agent orchestration, evaluation, retrieval, guardrails and human review.</p></article>
        <article><span>02</span><h3>Product engineering</h3><p>Python, TypeScript, SQL, Next.js, FastAPI, APIs, GitHub Actions and Vercel.</p></article>
        <article><span>03</span><h3>Data &amp; decisions</h3><p>Analytics engineering, experimentation, funnel analysis, financial analysis and executive communication.</p></article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
