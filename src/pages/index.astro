---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { additionalProjects, featuredProjects } from "../data/projects";
---

<BaseLayout>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Applied AI · Data systems · Enterprise operations</p>
        <h1 id="hero-title">Building trustworthy AI systems for <em>real operations.</em></h1>
        <p class="hero-lede">
          I turn messy documents, images and operational data into auditable workflows
          that help teams decide and act.
        </p>
        <p class="hero-meta">
          AI & Data Engineer Intern at Deutsche Windtechnik<br />
          MS Applied Analytics at Columbia University · December 2026
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">View selected work</a>
          <a class="text-link" href="https://www.linkedin.com/in/qijinghuang/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
      <figure class="portrait-frame">
        <img src="/images/kimberly-portrait.jpg" alt="Kimberly Huang at Columbia University" width="1080" height="1440" />
        <figcaption>
          <span>Kimberly (Qijing) Huang</span>
          <span>New York</span>
        </figcaption>
      </figure>
      <div class="hero-proof" aria-label="Selected career highlights">
        <div><strong>04</strong><span>enterprise AI pilots built</span></div>
        <div><strong>3rd</strong><span>NYC Tech Week hackathon</span></div>
        <div><strong>150M+</strong><span>transaction rows analyzed</span></div>
        <div><strong>4.0</strong><span>Columbia GPA</span></div>
      </div>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="section-index">01 / Selected work</p>
        <h2 id="work-title">Systems that move from signal to accountable action.</h2>
        <p>
          My strongest work sits where AI perception, deterministic validation and human
          judgment meet.
        </p>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading compact-heading">
        <p class="section-index">02 / Experience</p>
        <h2 id="experience-title">From analytics to applied AI delivery.</h2>
      </div>
      <div class="timeline">
        <article>
          <div class="timeline-meta"><span>Jun 2026 — Present</span><span>Houston / Global</span></div>
          <div>
            <p class="company">Deutsche Windtechnik</p>
            <h3>AI & Data Engineer Intern</h3>
            <p>
              Translate operational problems into secure AI-assisted workflows, local-first
              data tools and stakeholder-ready pilots across document generation, quality
              assurance, finance and enterprise AI adoption.
            </p>
          </div>
        </article>
        <article>
          <div class="timeline-meta"><span>Jul 2024 — Jun 2025</span><span>Shenzhen</span></div>
          <div>
            <p class="company">Temu</p>
            <h3>Data Analyst</h3>
            <p>
              Analyzed acquisition, activation, retention and monetization across 20+ markets;
              automated reporting workflows and translated funnel behavior into growth decisions.
            </p>
          </div>
        </article>
        <article>
          <div class="timeline-meta"><span>2023</span><span>Beijing / Manchester</span></div>
          <div>
            <p class="company">Securities research & finance</p>
            <h3>Research and Finance Internships</h3>
            <p>
              Built an analytical foundation across equity research, macroeconomic analysis,
              financial reporting and data-backed executive communication.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="section principles-section" id="principles" aria-labelledby="principles-title">
      <div class="section-heading">
        <p class="section-index">03 / How I work</p>
        <h2 id="principles-title">AI should extend judgment—not obscure it.</h2>
      </div>
      <div class="principle-grid">
        <article><span>01</span><h3>Ground the system</h3><p>Start with the real workflow, source data and constraints—not a generic chatbot.</p></article>
        <article><span>02</span><h3>Separate responsibilities</h3><p>Use models for perception and synthesis; use code for rules, calculations and controls.</p></article>
        <article><span>03</span><h3>Make uncertainty visible</h3><p>Expose evidence, confidence and missing information so people can review the result.</p></article>
        <article><span>04</span><h3>Ship for the operator</h3><p>Design around how nontechnical users actually receive, inspect and act on the output.</p></article>
      </div>
      <blockquote>
        <span>My operating principle</span>
        “AI reads. Deterministic code checks. People decide.”
      </blockquote>
    </section>

    <section class="section lab-section" id="about" aria-labelledby="lab-title">
      <div class="section-heading compact-heading">
        <p class="section-index">04 / Experiments</p>
        <h2 id="lab-title">Small products, sharp questions.</h2>
        <p>Hackathon builds and independent explorations across learning, productivity and software risk.</p>
      </div>
      <div class="lab-grid">
        {additionalProjects.map((project) => <ProjectCard project={project} compact />)}
      </div>
      <div class="about-strip">
        <div>
          <p class="section-index">About</p>
          <h3>Finance-trained.<br />Data-driven.<br />AI-native.</h3>
        </div>
        <div>
          <p>
            I am completing an MS in Applied Analytics at Columbia University after earning
            a BSc in Applied Finance from the University of Dundee. That combination shapes
            how I build: rigorous about evidence, practical about business value and explicit
            about risk.
          </p>
          <ul>
            <li>English & Mandarin</li>
            <li>ACCA certified</li>
            <li>New York based</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
