---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { additionalProjects, featuredProjects } from "../data/projects";
---

<BaseLayout>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Applied AI &amp; Data Engineer</p>
        <h1 id="hero-title">Kimberly Huang</h1>
        <p class="hero-role">I build reliable AI and data products for operational teams.</p>
        <p class="hero-lede">
          My work combines product judgment, data engineering and human-centered controls
          to move AI from a promising prototype into a system people can review and use.
        </p>
        <p class="hero-meta">
          AI &amp; Data Engineer Intern at Deutsche Windtechnik<br />
          Columbia University · MS Applied Analytics · December 2026
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#experience">View experience</a>
          <a class="text-link" href="mailto:huang0818hqj@outlook.com">Email</a>
          <a class="text-link" href="https://www.linkedin.com/in/qijinghuang/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
      <figure class="portrait-frame">
        <img src="/images/kimberly-portrait.jpg" alt="Kimberly Huang at Columbia University" width="1080" height="1440" />
        <figcaption><span>Kimberly (Qijing) Huang</span><span>New York</span></figcaption>
      </figure>
    </section>

    <section class="section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="section-index">Experience</p>
        <div>
          <h2 id="experience-title">Professional experience</h2>
          <p>Applied AI delivery, product analytics and decision support across enterprise environments.</p>
        </div>
      </div>
      <div class="timeline">
        <article>
          <div class="timeline-meta"><span>Jun 2026 — Present</span><span>Houston / Global</span></div>
          <div>
            <p class="company">Deutsche Windtechnik</p>
            <h3>AI &amp; Data Engineer Intern</h3>
            <p>
              Evaluate and build AI-assisted workflows for enterprise operations, with emphasis
              on data access, review controls, privacy and deployment readiness. Partner with
              stakeholders to translate ambiguous requests into bounded, testable products.
            </p>
          </div>
        </article>
        <article>
          <div class="timeline-meta"><span>Jul 2024 — Jun 2025</span><span>Shenzhen</span></div>
          <div>
            <p class="company">Temu</p>
            <h3>Data Analyst</h3>
            <p>
              Analyzed acquisition, activation, retention and monetization across more than 20
              markets; automated recurring reporting and translated funnel behavior into clear
              recommendations for growth teams.
            </p>
          </div>
        </article>
        <article>
          <div class="timeline-meta"><span>2023</span><span>Beijing / Manchester</span></div>
          <div>
            <p class="company">Securities research &amp; finance</p>
            <h3>Research and Finance Internships</h3>
            <p>
              Developed an analytical foundation across equity research, macroeconomic analysis,
              financial reporting and data-backed executive communication.
            </p>
          </div>
        </article>
      </div>
      <aside class="confidential-note" aria-label="Confidential work policy">
        <p class="section-index">Confidential work</p>
        <div>
          <h3>Internal work is presented at the level of responsibility and judgment.</h3>
          <p>
            Company data, protected interfaces and internal operating details are not reproduced.
            Public descriptions focus on the problem class, my role, system boundaries and the
            decisions I was accountable for.
          </p>
        </div>
      </aside>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="section-index">Selected work</p>
        <div>
          <h2 id="work-title">Public projects with working proof</h2>
          <p>
            These projects can be reviewed through a live product, source code or a detailed
            case study. Each one shows a different part of how I frame and ship AI systems.
          </p>
        </div>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="additional-work">
        <div class="subsection-heading">
          <h3>Additional projects</h3>
          <p>Focused builds across productivity, learning and software intelligence.</p>
        </div>
        <div class="lab-grid">
          {additionalProjects.map((project) => <ProjectCard project={project} compact />)}
        </div>
      </div>
    </section>

    <section class="section education-section" id="education" aria-labelledby="education-title">
      <div class="section-heading">
        <p class="section-index">Education</p>
        <div>
          <h2 id="education-title">Education &amp; credentials</h2>
          <p>A quantitative foundation across analytics, finance and applied machine learning.</p>
        </div>
      </div>
      <div class="education-list">
        <article>
          <p class="education-date">Expected Dec 2026</p>
          <div><h3>Columbia University</h3><p>Master of Science in Applied Analytics · GPA 4.0</p></div>
        </article>
        <article>
          <p class="education-date">Undergraduate</p>
          <div><h3>University of Dundee</h3><p>BSc Applied Finance · Top 1% · ACCA certified</p></div>
        </article>
      </div>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="section-index">About</p>
        <div>
          <h2 id="about-title">Analytical depth, practical delivery</h2>
          <p>
            I work best at the intersection of AI engineering, data analysis and product
            decision-making. My finance background makes me rigorous about evidence and risk;
            my engineering work keeps the focus on systems that hold up in real workflows.
          </p>
          <p>
            I am completing my master’s degree at Columbia University and am seeking full-time
            roles in applied AI, data engineering and AI solutions beginning after graduation.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
