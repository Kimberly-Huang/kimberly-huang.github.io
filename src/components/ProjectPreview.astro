---
interface Props {
  kind: "dwt" | "crewverify" | "signal" | "swift" | "lablens" | "tabflow" | "repairs";
}

const { kind } = Astro.props;
---

<div class:list={["project-preview", `preview-${kind}`]} aria-hidden="true">
  {kind === "dwt" && (
    <>
      <div class="preview-topline"><span>Enterprise AI portfolio</span><strong>04 pilots</strong></div>
      <div class="dwt-grid">
        <span>Document generation</span><span>Image QA</span><span>Finance workflow</span><span>Local search</span>
      </div>
      <div class="preview-metric"><strong>7,103</strong><span>embedded images reviewed</span></div>
    </>
  )}
  {kind === "crewverify" && (
    <>
      <div class="preview-topline"><span>Timesheet 0426</span><strong>3 exceptions</strong></div>
      <div class="timesheet-row"><span>ML</span><b>M. Lewis</b><span>07:00</span><span>15:30</span><i>Ready</i></div>
      <div class="timesheet-row flagged"><span>AR</span><b>A. Rivera</b><span>07:12</span><span>—</span><i>Review</i></div>
      <div class="validation-flow"><span>AI reads</span><span>Code checks</span><span>People decide</span></div>
    </>
  )}
  {kind === "signal" && (
    <>
      <div class="signal-copy">“The second-floor bathroom is flooding again.”</div>
      <div class="signal-steps"><span>Signal</span><span>Evidence</span><span>Action</span><span>Verify</span></div>
      <div class="confidence-row"><strong>Grounded</strong><span>Asset matched</span><span>Student follow-up</span></div>
    </>
  )}
  {kind === "swift" && (
    <>
      <div class="preview-topline"><span>First-online conversion</span><strong>2.56M customers</strong></div>
      <div class="swift-chart"><i style="--h: 38%"></i><i style="--h: 54%"></i><i style="--h: 46%"></i><i style="--h: 72%"></i><i style="--h: 88%"></i></div>
      <div class="decision-chain"><span>Diagnose</span><span>Prioritize</span><span>Validate</span></div>
    </>
  )}
  {kind === "lablens" && <div class="mini-title">Misconception → targeted hint → follow-up check</div>}
  {kind === "tabflow" && <div class="mini-title">18 tabs → 4 focused missions</div>}
  {kind === "repairs" && <div class="mini-title">Weak signal → risk score → repair action</div>}
</div>
