---
interface Props {
  kind: "crewverify" | "signal" | "lablens" | "tabflow" | "repairs";
}

const { kind } = Astro.props;
---

<div class:list={["project-preview", `preview-${kind}`]} aria-hidden="true">
  <div class="preview-chrome">
    <span>Portfolio preview</span>
    <span>Synthetic example</span>
  </div>

  {kind === "crewverify" && (
    <div class="preview-canvas crew-canvas">
      <div class="preview-titlebar"><div><span class="status-dot"></span>CrewVerify</div><strong>Review workspace</strong></div>
      <div class="crew-layout">
        <div class="paper-sheet">
          <p>Timesheet · 0426</p>
          <div><span>ML</span><b>M. Lewis</b><i>Ready</i></div>
          <div class="needs-review"><span>AR</span><b>A. Rivera</b><i>Review</i></div>
          <div><span>JT</span><b>J. Torres</b><i>Ready</i></div>
        </div>
        <div class="review-stack">
          <p>3 verifiable exceptions</p>
          <div><span>01</span><b>AI transcribes</b><i>Complete</i></div>
          <div><span>02</span><b>Rules validate</b><i>3 flags</i></div>
          <div><span>03</span><b>People approve</b><i>Required</i></div>
        </div>
      </div>
    </div>
  )}

  {kind === "signal" && (
    <div class="preview-canvas signal-canvas">
      <div class="preview-titlebar"><div><span class="status-dot"></span>Student Signal Copilot</div><strong>3rd Place Overall</strong></div>
      <div class="signal-report">
        <span>Student observation</span>
        <p>“The second-floor bathroom is flooding again.”</p>
      </div>
      <div class="signal-pipeline">
        <div><b>01</b><span>Signal</span><i>Captured</i></div>
        <div><b>02</b><span>Evidence</span><i>Grounded</i></div>
        <div><b>03</b><span>Action</span><i>Drafted</i></div>
        <div><b>04</b><span>Verify</span><i>Student</i></div>
      </div>
      <div class="audit-strip"><span>Asset matched</span><span>Confidence labeled</span><span>Human execution</span></div>
    </div>
  )}

  {kind === "lablens" && (
    <div class="preview-canvas lablens-canvas">
      <div class="preview-titlebar"><div><span class="status-dot"></span>LabLens</div><strong>Socratic STEM tutor</strong></div>
      <div class="lesson-prompt">
        <span>Physics · Series circuits</span>
        <p>What happens to current after it passes through the first resistor?</p>
        <div><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <div class="diagnosis-row">
        <div><span>Detected</span><b>“Current gets used up”</b></div>
        <div><span>Next move</span><b>Targeted question</b></div>
        <div><span>Follow-up</span><b>Check the model</b></div>
      </div>
    </div>
  )}

  {kind === "tabflow" && (
    <div class="preview-canvas compact-canvas">
      <div class="compact-metric"><strong>18</strong><span>open tabs</span></div>
      <div class="compact-arrow">→</div>
      <div class="compact-metric"><strong>04</strong><span>focused missions</span></div>
    </div>
  )}

  {kind === "repairs" && (
    <div class="preview-canvas compact-canvas">
      <div class="compact-metric"><strong>Signal</strong><span>weak dependency</span></div>
      <div class="compact-arrow">→</div>
      <div class="compact-metric"><strong>Repair</strong><span>bounded action</span></div>
    </div>
  )}
</div>
