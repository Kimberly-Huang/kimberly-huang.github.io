---
import { productShots, type PreviewKind } from "../data/shots";

interface Props {
  kind: PreviewKind;
}

const { kind } = Astro.props;
const shot = productShots[kind];
---

{shot ? (
  <div class:list={["project-preview", "preview-shot", `preview-${kind}`]} aria-hidden="true">
    <div class="shot-frame">
      <div class="shot-bar">
        <div class="shot-dots"><i></i><i></i><i></i></div>
        <span>{shot.window}</span>
        <b>{shot.badge}</b>
      </div>
      <picture>
        <source srcset={`${shot.src}.webp`} type="image/webp" />
        <img
          src={`${shot.src}.jpg`}
          alt=""
          width="1600"
          height="840"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <p class="shot-note">{shot.note}</p>
  </div>
) : (
  <div class:list={["project-preview", `preview-${kind}`]} aria-hidden="true">
    <div class="compact-preview">
      <span>{kind === "tabflow" ? "18 open tabs" : "Weak signal"}</span>
      <i>→</i>
      <strong>{kind === "tabflow" ? "04 focused missions" : "Bounded repair"}</strong>
    </div>
  </div>
)}
