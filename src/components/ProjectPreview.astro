---
interface Props {
  kind: "crewverify" | "signal" | "lablens" | "tabflow" | "repairs";
}

const { kind } = Astro.props;
---

<div class:list={["project-preview", `preview-${kind}`]} aria-hidden="true">
  {kind === "crewverify" && (
    <div class="crew-product-media">
      <img
        src="/images/crewverify-overview.jpg"
        alt=""
        width="1600"
        height="840"
        loading="lazy"
      />
      <div class="preview-caption">
        <span>Functional prototype</span>
        <span>Synthetic operational data</span>
      </div>
    </div>
  )}

  {kind === "signal" && (
    <div class="product-window signal-window">
      <div class="window-bar">
        <div><i></i><i></i><i></i></div>
        <span>Student Signal · Operator workspace</span>
        <b>Live trace</b>
      </div>
      <div class="signal-ui">
        <aside>
          <strong>Signal</strong>
          <span class="nav-active">Inbox <b>04</b></span>
          <span>Work orders</span>
          <span>Asset map</span>
          <span>Verification</span>
        </aside>
        <div class="signal-main">
          <div class="signal-header">
            <div><small>STUDENT OBSERVATION</small><strong>“It is flooding again.”</strong></div>
            <span>URGENT</span>
          </div>
          <div class="signal-columns">
            <div class="trace-list">
              <small>SUPERVISOR TRACE</small>
              <div><i>01</i><span><b>Extract</b><small>Observation structured</small></span><em>Verified</em></div>
              <div><i>02</i><span><b>Ground</b><small>Asset + public data</small></span><em>Matched</em></div>
              <div><i>03</i><span><b>Route</b><small>Human action drafted</small></span><em>Review</em></div>
            </div>
            <div class="verification-card">
              <small>CLOSE THE LOOP</small>
              <strong>Did the repair work?</strong>
              <p>The original reporter verifies reality—not the model.</p>
              <div><span>Fixed</span><span>Still happening</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  {kind === "lablens" && (
    <div class="product-window lab-window">
      <div class="window-bar">
        <div><i></i><i></i><i></i></div>
        <span>LabLens · Circuits mini-lab</span>
        <b>Physics</b>
      </div>
      <div class="lab-ui">
        <div class="lab-sidebar">
          <small>YOUR PREDICTION</small>
          <strong>Does current get “used up” across R1?</strong>
          <div class="answer-selected"><i></i>Yes, some is consumed</div>
          <div><i></i>No, it stays the same</div>
          <span>Prediction recorded</span>
        </div>
        <div class="experiment-stage">
          <div class="stage-label"><small>LIVE EXPERIMENT</small><span>12.0 V</span></div>
          <div class="circuit-demo">
            <span class="battery-demo">＋<i></i>−</span>
            <span class="wire wire-top"></span>
            <span class="resistor-demo resistor-a">R1</span>
            <span class="resistor-demo resistor-b">R2</span>
            <span class="wire wire-bottom"></span>
            <em class="meter meter-a">1.2 A</em>
            <em class="meter meter-b">1.2 A</em>
          </div>
          <div class="coach-card">
            <small>SOCRATIC COACH</small>
            <strong>Measure before and after R1. What changed?</strong>
            <span>Hint 1 of 3 · smallest useful intervention</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {(kind === "tabflow" || kind === "repairs") && (
    <div class="compact-preview">
      <span>{kind === "tabflow" ? "18 open tabs" : "Weak signal"}</span>
      <i>→</i>
      <strong>{kind === "tabflow" ? "04 focused missions" : "Bounded repair"}</strong>
    </div>
  )}
</div>
