---
import type { Project } from "../data/projects";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
---

<article class:list={["project-card", compact && "project-card-compact"]}>
  <ProjectPreview kind={project.preview} />
  <div class="project-copy">
    <div class="project-kicker">
      <span>{project.number}</span>
      <span>{project.eyebrow}</span>
      {project.award && <strong>{project.award}</strong>}
      {project.confidential && <strong>Selected details</strong>}
    </div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    {!compact && (
      <dl class="project-evidence">
        <div><dt>My role</dt><dd>{project.contribution}</dd></div>
        <div><dt>Proof</dt><dd>{project.outcome}</dd></div>
      </dl>
    )}
    <div class="project-footer">
      <ul aria-label={`${project.title} technologies`}>
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <div class="project-links">
        {!compact && <a class="case-link" href={`/work/${project.slug}`}>Case study <span aria-hidden="true">→</span></a>}
        {project.demo && <a href={project.demo} target="_blank" rel="noreferrer">Live demo <span aria-hidden="true">↗</span></a>}
        {project.repo && <a href={project.repo} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </div>
</article>
