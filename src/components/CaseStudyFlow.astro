---
interface Props {
  slug: string;
  steps: { label: string; title: string; body: string; evidence: string }[];
}

const { slug, steps } = Astro.props;
---

<div class="case-flow" data-case-flow={slug}>
  <div class="case-flow-tabs" role="tablist" aria-label="Case study workflow">
    {steps.map((step, index) => (
      <button
        type="button"
        role="tab"
        id={`${slug}-tab-${index}`}
        aria-controls={`${slug}-panel-${index}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? "0" : "-1"}
      >
        <span>{String(index + 1).padStart(2, "0")}</span>{step.label}
      </button>
    ))}
  </div>
  <div class="case-flow-panels">
    {steps.map((step, index) => (
      <section
        role="tabpanel"
        id={`${slug}-panel-${index}`}
        aria-labelledby={`${slug}-tab-${index}`}
        hidden={index !== 0}
      >
        <p class="section-index">{step.label}</p>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
        <div><span>Evidence</span><p>{step.evidence}</p></div>
      </section>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll("[data-case-flow]").forEach((flow) => {
    const tabs = Array.from(flow.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(flow.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const activate = (target: HTMLButtonElement) => {
      tabs.forEach((tab, index) => {
        const selected = tab === target;
        tab.setAttribute("aria-selected", String(selected));
        tab.setAttribute("tabindex", selected ? "0" : "-1");
        panels[index].toggleAttribute("hidden", !selected);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        activate(next);
        next.focus();
      });
    });
  });
</script>
