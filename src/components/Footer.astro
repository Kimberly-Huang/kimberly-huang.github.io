---
import { site } from "../data/site";
---

<footer class="site-footer" id="contact">
  <div class="footer-shell">
    <div class="footer-primary">
      <p class="section-label">04 / Contact</p>
      <h2>Build the useful thing.<br /><em>Make the reasoning visible.</em></h2>
    </div>
    <div class="footer-contact">
      <p>Graduating in December 2026 and looking for full-time roles beginning in 2027 across applied AI, AI product and data engineering.</p>
      <a class="footer-email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
      <div class="footer-links">
        <a href={site.resume}>Résumé (PDF) ↓</a>
        <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {site.name}</span>
      <span>New York · Applied AI · Product Engineering · Data</span>
    </div>
  </div>
</footer>
